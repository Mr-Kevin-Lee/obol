{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obol",
  "version": "0.1.0",
  "identifier": "com.obol.app",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix desktop/ui run dev",
    "beforeBuildCommand": "npm --prefix desktop/ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Obol",
        "width": 1100,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "entitlements": "../../entitlements.plist"
    }
  }
}
